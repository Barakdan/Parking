# Render environment variables for production
VITE_API_URL=https://your-backend.onrender.com/api/parking/check
ALLOWED_ORIGINS=https://your-frontend.onrender.com
# Comma-separated ArcGIS query URLs for all supported cities.
# Leave empty to use the default Tel Aviv GIS URL.
PARKING_ZONES_URLS=https://gisn.tel-aviv.gov.il/arcgis/rest/services/IView2/MapServer/544/query,https://your-ramat-gan-gis-url/query
# Gemini AI credentials for image/text analysis support.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Optional local development values
# VITE_API_URL=http://localhost:3000/api/parking/check
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PARKING_ZONES_URLS=http://localhost:3000/tel-aviv/query,http://localhost:3000/ramat-gan/query
